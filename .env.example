OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Used only by video/cut flows that need accurate segment timestamps. This OpenAI model is deprecated on 2027-02-26.
OPENAI_TIMESTAMP_TRANSCRIBE_MODEL=whisper-1
OPENAI_LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_REALTIME_TTS_MODEL=gpt-realtime-2.1-mini
OPENAI_TTS_VOICE=marin

MAX_PARALLEL_TRANSCRIPTIONS=3
MAX_FILE_SIZE_MB=125
MAX_VIDEO_UPLOAD_MB=125
MAX_VIDEO_DURATION_SEC=7200
MAX_ACTIVE_CUT_JOBS=2
MAX_ANALYSIS_CONCURRENCY=1
MAX_RENDER_CONCURRENCY=1
CUT_OUTPUT_TTL_MINUTES=60
PROCESS_TIMEOUT_MS=900000
YTDLP_BIN=yt-dlp
YTDLP_PROXY_URL=
FFMPEG_BIN=
FFPROBE_BIN=
TEMP_UPLOAD_DIR=./tmp/uploads

APP_NAME=Leste Audio IA
