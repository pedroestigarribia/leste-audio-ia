{
  "name": "leste-audio-ia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next-dev',{recursive:true,force:true})\" && next dev",
    "clean": "node -e \"const fs=require('fs');for(const p of ['.next','.next-dev','tsconfig.tsbuildinfo'])fs.rmSync(p,{recursive:true,force:true})\"",
    "build": "next build",
    "start": "node server.js",
    "start:next": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:session": "node scripts/test-session-processing.cjs",
    "test:voice": "node scripts/test-voice-live.cjs",
    "test:voice:audio": "node scripts/test-voice-audio.cjs",
    "backup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-leste-audio-ia.ps1",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/empacotar-leste-audio-ia.ps1",
    "package:windows:private": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/empacotar-leste-audio-ia.ps1 -IncludeLocalEnv -OutputPath leste-audio-ia-distribuicao-privada.zip"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@derhuerst/ffprobe-static": "^5.3.0",
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "latest",
    "docx": "^9.5.1",
    "execa": "^9.5.2",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "nanoid": "^5.0.9",
    "next": "^15.5.27",
    "openai": "^4.76.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "youtube-dl-exec": "^3.0.22",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "argparse": "2.0.1",
    "postcss": "$postcss"
  }
}
